generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickups   Pickup[]
  payments  Payment[]
}

model Pickup {
  id            String   @id @default(uuid())
  userId        String
  wasteType     String
  date          String
  timeWindow    String
  status        String   @default("Scheduled")
  collectorName String?
  requestId     String   @unique
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model Payment {
  id        String    @id @default(uuid())
  userId    String
  amount    Int
  status    String    @default("Pending")
  method    String?
  dueDate   String?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
}